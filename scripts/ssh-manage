#!/usr/bin/env bash
# -----------------------------------------------------------------------------
# Add and remove hosts, purposes and environments in ~/.ssh/config.d.
#
#   ssh-manage add-host [env] [purpose] [server] [ip] [--hostname NAME]
#   ssh-manage rm-host  [alias]                         remove a server
#   ssh-manage add-env  [env]                           create an environment
#   ssh-manage rm-env   [env]                           delete an environment
#
# Every write is backed up first, then validated with `ssh -G`; if validation
# fails the backup is restored automatically, so a bad edit cannot leave you
# with an unusable SSH config.
#
# New host blocks are always inserted ABOVE the wildcard blocks, because
# OpenSSH is first-match-wins: a host placed below `Host <env>_*` would never
# get to override anything.
# -----------------------------------------------------------------------------
set -uo pipefail

SSH_DIR="${SSH_DIR:-$HOME/.ssh}"
CONF_D="$SSH_DIR/config.d"
if [ -t 1 ]; then B=$'\033[1m'; G=$'\033[32m'; Y=$'\033[33m'; RD=$'\033[31m'; D=$'\033[2m'; N=$'\033[0m'
else B=''; G=''; Y=''; RD=''; D=''; N=''; fi

die()  { printf '%s%s%s\n' "$RD" "$*" "$N" >&2; exit 1; }
info() { printf '  %s\n' "$*"; }
okay() { printf '  %s%s%s\n' "$G" "$*" "$N"; }

ask() { # ask <prompt> <default> -> echoes answer
    local p="$1" def="${2:-}" a
    if [ -n "$def" ]; then printf '%s [%s]: ' "$p" "$def" >&2; else printf '%s: ' "$p" >&2; fi
    read -r a; printf '%s' "${a:-$def}"
}

confirm() { local a; printf '%s [y/N]: ' "$1" >&2; read -r a; [ "${a:-n}" = y ] || [ "${a:-n}" = Y ]; }

envs() {
    local f
    for f in "$CONF_D"/*.conf; do
        [ -e "$f" ] || continue
        f="${f##*/}"; f="${f%.conf}"
        [ "$f" = 00-local ] || printf '%s\n' "$f"
    done
}

aliases_in() { # aliases_in <file>...  -> concrete aliases only
    # Every file, not just "$1": callers pass "$CONF_D"/*.conf to check the
    # whole fleet, and reading only the first file (00-local.conf) let a
    # duplicate alias through -- one that first-match-wins then hides.
    grep -h '^[[:space:]]*Host[[:space:]]' "$@" 2>/dev/null |
    sed 's/^[[:space:]]*Host[[:space:]]*//' | tr ' ' '\n' | grep -v '[*?]' | grep -v '^$'
}

# --- validation with automatic rollback --------------------------------------
validate_or_restore() { # validate_or_restore <file> <backup> [probe-alias]
    local f="$1" bak="$2" probe="${3:-}"
    local err rc
    # Exit status is the real signal. "Pseudo-terminal will not be allocated"
    # is emitted whenever stdin is not a tty and is not a configuration error.
    err=$(ssh -G "${probe:-nonexistent-probe-host}" </dev/null 2>&1 >/dev/null \
          | grep -v 'Pseudo-terminal will not be allocated')
    rc=${PIPESTATUS[0]:-0}
    ssh -G "${probe:-nonexistent-probe-host}" </dev/null >/dev/null 2>&1; rc=$?
    if [ "$rc" -ne 0 ] || [ -n "$err" ]; then
        cp -a "$bak" "$f"
        printf '%s\n' "$RD  config rejected, change rolled back:$N" >&2
        printf '  %s\n' "$err" >&2
        return 1
    fi
    if [ -n "$probe" ]; then
        local h; h=$(ssh -G "$probe" 2>/dev/null | awk '$1=="hostname"{print $2; exit}')
        [ "$h" = "$probe" ] && { cp -a "$bak" "$f"; die "  $probe did not resolve to an address, rolled back"; }
    fi
    return 0
}

backup() { local f="$1" b; b="$f.bak-$(date +%Y%m%d-%H%M%S)"; cp -a "$f" "$b"; printf '%s' "$b"; }

# =============================================================================
add_host() {
    # --hostname NAME may appear anywhere; everything else is positional.
    local hn_arg="" a; local -a pos=()
    while [ $# -gt 0 ]; do
        case "$1" in
            --hostname)   hn_arg="${2:-}"; shift 2 || shift ;;
            --hostname=*) hn_arg="${1#--hostname=}"; shift ;;
            *)            pos+=("$1"); shift ;;
        esac
    done
    set -- "${pos[@]}"
    local env="${1:-}" purpose="${2:-}" server="${3:-}" ip="${4:-}" user_arg="${5:-}"
    # Fully specified on the command line = no prompts at all (scriptable).
    local batch=0; [ $# -ge 4 ] && batch=1

    if [ -z "$env" ]; then
        printf '\n%sEnvironments:%s %s\n' "$B" "$N" "$(envs | paste -sd' ')"
        env=$(ask "environment")
    fi
    local file="$CONF_D/$env.conf"
    [ -f "$file" ] || die "no such environment: $env  (create it with: ssh-manage add-env $env)"

    if [ -z "$purpose" ]; then
        local existing
        existing=$(aliases_in "$file" | awk -F_ -v e="$env" 'NF>=3 {print $2}' | sort -u | paste -sd' ')
        printf '%sPurposes in %s:%s %s\n' "$B" "$env" "$N" "${existing:-<none yet>}"
        purpose=$(ask "purpose (e.g. iac, k8s, sre, db, net)")
    fi
    [ -z "$server" ] && server=$(ask "server name (e.g. ceph4, worker8)")
    [ -z "$ip" ]     && ip=$(ask "IP address or hostname")

    [ -z "$env$purpose$server$ip" ] && die "aborted: all fields are required"
    case "$env$purpose$server" in *[!a-zA-Z0-9_-]*) die "names may only contain letters, digits, '-' and '_'";; esac

    local alias="${env}_${purpose}_${server}"
    aliases_in "$CONF_D"/*.conf | grep -qx "$alias" && die "alias already exists: $alias"

    local dupe
    dupe=$(grep -l "^[[:space:]]*HostName[[:space:]]\+${ip}[[:space:]]*$" "$CONF_D"/*.conf 2>/dev/null | head -1)
    if [ -n "$dupe" ]; then
        printf '%s  note: %s is already used in %s%s\n' "$Y" "$ip" "$(basename "$dupe")" "$N"
        confirm "  add anyway?" || exit 1
    fi

    local user="$user_arg" hn="$hn_arg"
    if [ "$batch" -eq 0 ]; then
        local inherited
        inherited=$(ssh -G "$(aliases_in "$file" | head -1)" 2>/dev/null | awk '$1=="user"{print $2;exit}')
        user=$(ask "user (blank = inherit '${inherited:-$(id -un)}')" "")
        [ -z "$hn" ] && hn=$(ask "real hostname, used by search (blank = none)" "")
    fi
    case "$hn" in *[!a-zA-Z0-9._-]*) die "hostname may only contain letters, digits, '.', '-' and '_'";; esac

    local block="Host $alias
    HostName $ip"
    [ -n "$user" ] && block="$block
    User $user"
    # Structured comment: ssh ignores it, ssh-menu and ssh-find index it.
    [ -n "$hn" ] && block="$block
    # hostname: $hn"

    local bak; bak=$(backup "$file")

    # Insert after the last host of the same purpose, else above the first
    # wildcard block. Never below it -- first-match-wins would neuter it.
    local ins
    # Only the Host line and its indented option lines count as "the block".
    # A comment at column 0 starts the next section and must not be absorbed,
    # or the new host lands under the wrong heading.
    ins=$(awk -v pfx="${env}_${purpose}_" '
        /^[[:space:]]*Host[[:space:]]/ {
            inblk = ($2 ~ "^" pfx) ? 1 : 0
            if (inblk) last = NR
            next
        }
        inblk && /^[[:space:]]+[^[:space:]]/ { last = NR; next }
        inblk && /^[^[:space:]]/             { inblk = 0 }
        END { print last+0 }' "$file")

    if [ "$ins" -gt 0 ]; then
        awk -v n="$ins" -v blk="$block" 'NR==n {print; print ""; print blk; next} {print}' "$file" > "$file.new"
    else
        # New purpose: give it its own section, placed ABOVE the first wildcard
        # block AND above that block's column-0 banner comment. Inserting
        # directly before the "Host <env>_*" line would file the new host under
        # the "ENVIRONMENT DEFAULTS" heading.
        # The purpose is passed with -v: a trailing NAME=value argument is an awk
        # variable assignment, not an environment variable, so ENVIRON[] never
        # saw it and the heading came out blank.
        awk -v blk="$block" -v purpose="$purpose" '
            { L[NR] = $0 }
            END {
                dash = "# -----------------------------------------------------------------------------"
                w = 0
                for (i = 1; i <= NR; i++)
                    if (L[i] ~ /^[[:space:]]*Host[[:space:]]/ && L[i] ~ /[*?]/) { w = i; break }
                if (w == 0) {
                    for (i = 1; i <= NR; i++) print L[i]
                    print ""; print ""; print dash; print "# " purpose; print dash; print ""; print blk
                    exit
                }
                b = w
                while (b > 1 && L[b-1] ~ /^#/) b--
                for (i = 1; i < b; i++) print L[i]
                print dash; print "# " purpose; print dash; print ""; print blk; print ""; print ""
                for (i = b; i <= NR; i++) print L[i]
            }' "$file" > "$file.new"
    fi
    mv "$file.new" "$file"; chmod 600 "$file"

    validate_or_restore "$file" "$bak" "$alias" || exit 1
    okay "added $alias -> $ip"
    # What the new host resolves to. An identity file only matters when public-key
    # auth is on; for a password environment ssh -G lists five default key paths
    # that will never be used, which reads like a misconfiguration.
    ssh -G "$alias" 2>/dev/null | awk '
        $1 == "pubkeyauthentication"                    { pk = ($2 == "yes" || $2 == "true") }
        $1 == "user" || $1 == "hostname" || $1 == "proxyjump" { print }
        $1 == "identityfile" && !seen++                 { idf = $0 }
        END { if (pk) print idf; else print "auth password (pubkey off)" }' | sed 's/^/    /'
    info "${D}backup: $(basename "$bak")${N}"
}

# =============================================================================
rm_host() {
    local alias="${1:-}"
    if [ -z "$alias" ]; then
        printf '\n%sHosts:%s\n' "$B" "$N"
        aliases_in "$CONF_D"/*.conf | sort | nl -w4 | sed 's/^/  /'
        alias=$(ask "alias to remove")
    fi
    [ -z "$alias" ] && die "aborted"

    local file
    file=$(grep -l "^[[:space:]]*Host[[:space:]].*\b$alias\b" "$CONF_D"/*.conf 2>/dev/null | head -1)
    [ -n "$file" ] || die "alias not found: $alias"

    printf '\n%sWill remove from %s:%s\n' "$B" "$(basename "$file")" "$N"
    awk -v a="$alias" '
        /^[[:space:]]*Host[[:space:]]/ { inblk = 0; for (i=2;i<=NF;i++) if ($i==a) inblk=1 }
        inblk { print "    " $0 }' "$file"
    confirm "  remove it?" || { echo "  aborted."; exit 1; }

    local bak; bak=$(backup "$file")

    # A shared "Host a b" line loses only the one alias; a sole alias loses the
    # whole block, up to the last non-blank line before the next Host.
    awk -v a="$alias" '
        /^[[:space:]]*Host[[:space:]]/ {
            n=0; keep=""
            for (i=2;i<=NF;i++) if ($i != a) { keep = keep " " $i; n++ }
            isours=0; for (i=2;i<=NF;i++) if ($i==a) isours=1
            if (isours && n>0) { print "Host" keep; skip=0; next }
            if (isours && n==0) { skip=1; next }
            skip=0
        }
        # A block is the Host line plus its INDENTED continuation lines, plus at
        # most one trailing blank. A column-0 comment belongs to the next
        # section and must survive -- removing it would eat section headers.
        skip && /^[[:space:]]+[^[:space:]]/ { next }
        skip && /^[[:space:]]*$/            { skip=0; next }
        skip                                { skip=0 }
        { print }' "$file" > "$file.new"
    mv "$file.new" "$file"; chmod 600 "$file"

    # If that was the last host under a section ssh-manage itself created
    # ("# ----" / "# <purpose>" / "# ----"), drop the now-empty banner as well,
    # so add followed by remove leaves the file exactly as it was. Only that
    # exact three-line shape is ever touched: hand-written section comments,
    # which carry more than a bare purpose name, are never removed.
    local rpurpose=""
    case "$alias" in *_*_*) rpurpose="${alias#*_}"; rpurpose="${rpurpose%%_*}" ;; esac
    if [ -n "$rpurpose" ]; then
        awk -v purpose="$rpurpose" '
            { L[NR] = $0 }
            END {
                for (i = 1; i + 2 <= NR; i++) {
                    if (L[i] ~ /^# -+$/ && L[i+1] == "# " purpose && L[i+2] ~ /^# -+$/) {
                        j = i + 3
                        while (j <= NR && L[j] ~ /^[[:space:]]*$/) j++
                        if (j > NR || L[j] ~ /^#/ || (L[j] ~ /^Host[[:space:]]/ && L[j] ~ /[*?]/))
                            for (k = i; k < j; k++) drop[k] = 1
                    }
                }
                for (i = 1; i <= NR; i++) if (!(i in drop)) print L[i]
            }' "$file" > "$file.new" && mv "$file.new" "$file" && chmod 600 "$file"
    fi

    local probe; probe=$(aliases_in "$file" | head -1)
    validate_or_restore "$file" "$bak" "$probe" || exit 1
    aliases_in "$CONF_D"/*.conf | grep -qx "$alias" && { cp -a "$bak" "$file"; die "removal failed, rolled back"; }
    okay "removed $alias"
    info "${D}backup: $(basename "$bak")  |  host key still in known_hosts.d, clear with:${N}"
    info "${D}  ssh-keygen -R <ip> -f $SSH_DIR/known_hosts.d/$(basename "$file" .conf)${N}"
}

# =============================================================================
add_env() {
    local env="${1:-}"
    [ -z "$env" ] && env=$(ask "new environment name")
    [ -z "$env" ] && die "aborted"
    case "$env" in *[!a-zA-Z0-9-]*) die "environment names may only contain letters, digits and '-'";; esac
    local file="$CONF_D/$env.conf"
    [ -f "$file" ] && die "already exists: $file"

    local bastion; bastion=$(ask "bastion IP (blank = hosts reachable directly)" "")

    { echo "# ============================================================================="
      echo "#  Environment: $env"
      echo "#  Account:     inherited from \"Host *\" in ~/.ssh/config"
      echo "#  Key:         ~/.ssh/keys/${env}_ed25519"
      echo "#"
      echo "#  Alias convention:  <environment>_<purpose>_<server>"
      echo "#  Add hosts ABOVE the wildcard blocks -- OpenSSH is first-match-wins."
      echo "# ============================================================================="
      echo
      if [ -n "$bastion" ]; then
        echo "Host ${env}_bastion"
        echo "    HostName $bastion"
        echo "    ControlPersist 30m"
        echo
        echo "# -----------------------------------------------------------------------------"
        echo "# Everything except the bastion is reached through it."
        echo "# -----------------------------------------------------------------------------"
        echo "Host ${env}_iac_* ${env}_k8s_* ${env}_sre_*"
        echo "    ProxyJump ${env}_bastion"
        echo
      fi
      echo "# -----------------------------------------------------------------------------"
      echo "# ENVIRONMENT DEFAULTS -- read last in this file, so host blocks win over it."
      echo "# -----------------------------------------------------------------------------"
      echo "Host ${env}_*"
      echo "    IdentityFile ~/.ssh/keys/${env}_ed25519"
      echo "    IdentitiesOnly yes"
      echo "    UserKnownHostsFile ~/.ssh/known_hosts.d/$env"
      echo "    Tag $env"
    } > "$file"
    chmod 600 "$file"
    okay "created $file"

    if [ ! -f "$SSH_DIR/keys/${env}_ed25519" ] && confirm "  generate ~/.ssh/keys/${env}_ed25519 now?"; then
        ssh-keygen -t ed25519 -a 100 -f "$SSH_DIR/keys/${env}_ed25519" \
                   -C "$(whoami)@$(hostname -s) $env $(date +%Y-%m)"
        chmod 600 "$SSH_DIR/keys/${env}_ed25519"; chmod 644 "$SSH_DIR/keys/${env}_ed25519.pub"
        okay "key generated"
    fi
    info "next: ssh-manage add-host $env <purpose> <server> <ip>"
}

# =============================================================================
rm_env() {
    local env="${1:-}"
    if [ -z "$env" ]; then
        printf '\n%sEnvironments:%s %s\n' "$B" "$N" "$(envs | paste -sd' ')"
        env=$(ask "environment to delete")
    fi
    local file="$CONF_D/$env.conf"
    [ -f "$file" ] || die "no such environment: $env"

    local n; n=$(aliases_in "$file" | wc -l)
    printf '\n%sThis deletes %s and its %s host(s).%s\n' "$RD" "$(basename "$file")" "$n" "$N"
    confirm "  delete environment '$env'?" || { echo "  aborted."; exit 1; }

    local bak; bak="$file.removed-$(date +%Y%m%d-%H%M%S)"
    mv "$file" "$bak"
    okay "removed $env  ${D}(config kept at $(basename "$bak"))${N}"

    if [ -f "$SSH_DIR/keys/${env}_ed25519" ]; then
        confirm "  also delete the key ~/.ssh/keys/${env}_ed25519?" &&
            { rm -f "$SSH_DIR/keys/${env}_ed25519" "$SSH_DIR/keys/${env}_ed25519.pub"; okay "key deleted"; } ||
            info "${D}key kept${N}"
    fi
    [ -f "$SSH_DIR/known_hosts.d/$env" ] && confirm "  also delete known_hosts.d/$env?" &&
        { rm -f "$SSH_DIR/known_hosts.d/$env"; okay "host keys deleted"; }
    # The environment is gone either way; a missing or kept known_hosts file
    # must not turn a successful removal into a failing exit status.
    return 0
}

case "${1:-}" in
    add-host|add)     shift; add_host "$@" ;;
    rm-host|rm|del)   shift; rm_host  "$@" ;;
    add-env)          shift; add_env  "$@" ;;
    rm-env)           shift; rm_env   "$@" ;;
    list)             for f in "$CONF_D"/*.conf; do printf '%s%s%s\n' "$B" "$(basename "$f" .conf)" "$N"
                          aliases_in "$f" | sed 's/^/  /'; done ;;
    -h|--help|"")     sed -n '3,17p' "$0" | sed 's/^# \?//' ;;
    *)                die "unknown command: $1  (try --help)" ;;
esac
